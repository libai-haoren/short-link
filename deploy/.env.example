# 复制为 .env 后按需修改（docker compose 会自动读取同目录下的 .env）
# 注意：密码里不要带 $ 和空格，compose 插值会出问题

MYSQL_ROOT_PASSWORD=shortlink
MYSQL_PORT=3306
REDIS_PORT=6379
ADMIN_PORT=8082
REDIRECT_PORT=8081

# 短链展示域名，只影响 admin 返回的 shortUrl 字段
SHORT_DOMAIN=s.example.com

# FPE 密钥：泄露等于短码可预测，生产必须放配置中心
CODEC_KEY=905197557613

# 关掉可做"无本地缓存"的基准压测
L1_ENABLED=true

ADMIN_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseZGC
REDIRECT_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseZGC
