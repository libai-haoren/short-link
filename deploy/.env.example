# 复制为 .env 后按需修改（docker compose 会自动读取同目录下的 .env）
# 注意：密码里不要带 $ 和空格，compose 插值会出问题

MYSQL_ROOT_PASSWORD=shortlink
MYSQL_PORT=3306
REDIS_PORT=6379
ADMIN_PORT=8082
REDIRECT_PORT=8081
GATEWAY_PORT=8080

# 短链展示域名，只影响 admin 返回的 shortUrl 字段
SHORT_DOMAIN=s.example.com

# FPE 密钥：泄露等于短码可预测，生产必须放配置中心
CODEC_KEY=905197557613

# 关掉可做"无本地缓存"的基准压测
L1_ENABLED=true

# ---- 鉴权 ----
# admin 与 gateway 必须用同一个密钥，少于 32 字节会直接启动失败（HS256 硬要求）
JWT_SECRET=shortlink-dev-secret-please-change-in-production-0123456789
# 开发账号 admin / admin123，这里存的是口令的 SHA-256（不是明文）
ADMIN_PASSWORD_SHA256=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
# 改成 false 可关掉网关鉴权，方便排查"是鉴权拦的还是下游报的"
AUTH_ENABLED=true

# ---- 限流 ----
# 每 IP 每窗口（默认 60s）允许的请求数
RATE_LIMIT_CAPACITY=600
RATE_LIMIT_ENABLED=true

ADMIN_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseZGC
REDIRECT_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseZGC
GATEWAY_JAVA_OPTS=-Xms256m -Xmx512m
