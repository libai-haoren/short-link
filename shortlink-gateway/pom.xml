<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shortlink</groupId>
        <artifactId>shortlink</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shortlink-gateway</artifactId>
    <name>shortlink-gateway</name>
    <description>接入层：路由、JWT 鉴权、IP 限流、TraceId 注入</description>

    <dependencies>
        <dependency>
            <groupId>com.shortlink</groupId>
            <artifactId>shortlink-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shortlink</groupId>
            <artifactId>shortlink-common-jwt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shortlink</groupId>
            <artifactId>shortlink-common-webflux</artifactId>
        </dependency>
        <!-- IP 黑名单（IpBlacklist）住在 common-cache 里，与 redirect 共用同一份实现 -->
        <dependency>
            <groupId>com.shortlink</groupId>
            <artifactId>shortlink-common-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <!--
          服务发现（Nacos）与 LoadBalancer 暂不引入：本地没有注册中心可跑，
          lb:// 路由反而会让网关启动后不可用。路由地址改成可配置的静态 URI，
          接入注册中心后把 ADMIN_URI 换成 lb://shortlink-admin 即可，代码零改动。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
